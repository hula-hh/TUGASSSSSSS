const SHEETS={STUDENTS:'Students',ATTENDANCE:'Attendance'};function doGet(){return json({ok:true,service:'ABSENSIQU API',version:'1.0'})}function doPost(e){try{const body=JSON.parse(e.postData.contents||'{}');switch(body.action){case'getStudents':return json({ok:true,data:read(SHEETS.STUDENTS)});case'getAttendance':return json({ok:true,data:read(SHEETS.ATTENDANCE)});case'addStudent':append(SHEETS.STUDENTS,body.student);return json({ok:true});case'addAttendance':append(SHEETS.ATTENDANCE,body.attendance);return json({ok:true});default:return json({ok:false,error:'Unknown action'})}}catch(err){return json({ok:false,error:String(err)})}}function read(name){const s=SpreadsheetApp.getActive().getSheetByName(name);if(!s)return[];const v=s.getDataRange().getValues();if(v.length<2)return[];return v.slice(1).filter(r=>r.join('')!=='').map(r=>{const o={};v[0].forEach((h,i)=>o[h]=r[i]);return o})}function append(name,obj){const s=SpreadsheetApp.getActive().getSheetByName(name);if(!s)throw Error('Sheet '+name+' not found');const headers=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(headers.map(h=>obj[h]??''))}function json(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}